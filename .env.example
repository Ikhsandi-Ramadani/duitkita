# ==================== DuitKita — contoh konfigurasi ====================
# Salin ke .env lalu isi nilainya. JANGAN commit berkas .env yang asli.
#
# Untuk deploy di VPS ini, berkas .env dibuat otomatis saat pemasangan
# pertama. Berkas ini hanya acuan kalau perlu memasang di server lain.

APP_NAME="DuitKita"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://duitkita.ikhsandi.web.id
APP_TIMEZONE=Asia/Makassar
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_LEVEL=warning

# ---------- Database (dibaca juga oleh docker-compose.yml) ----------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=duitkita
DB_USERNAME=duitkita
DB_PASSWORD=
DB_ROOT_PASSWORD=

# ---------- Sesi, cache, antrean ----------
SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

# ---------- Sanctum ----------
SANCTUM_STATEFUL_DOMAINS=duitkita.ikhsandi.web.id

# ---------- Akun super admin (dipakai SuperAdminSeeder) ----------
# Minimal 12 karakter. Seeder menolak berjalan di production kalau kosong
# atau terlalu pendek, supaya akun super admin tidak memakai sandi bawaan.
ADMIN_EMAIL=admin@duitkita.com
ADMIN_PASSWORD=

# ---------- Surat ----------
MAIL_MAILER=log
