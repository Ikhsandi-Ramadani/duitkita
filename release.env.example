# DuitKita release config — copy to ~/.duitkita-release.env and edit.
# ~/.duitkita-release.env is loaded by release.sh.

# SSH target: either user@host or a Host alias from ~/.ssh/config
SSH_HOST="root@duitkita.ikhsandi.web.id"

# Absolute path to the project on the server (where deploy.sh cloned it)
APP_DIR="/var/www/duitkita"

# Public base URL (no trailing /api). Used for dart-define + download URL.
API_URL="https://duitkita.ikhsandi.web.id"

# Target Android ABI for the APK uploaded to the server.
# arm64-v8a = modern 64-bit (recommended). Others: armeabi-v7a, x86_64.
ABI="arm64-v8a"

# Set to 1 to skip the scp step (APK already uploaded manually).
# SKIP_UPLOAD=1
