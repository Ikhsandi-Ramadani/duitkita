# DuitKita release config — copy to ~/.duitkita-release.env and edit.
# ~/.duitkita-release.env is loaded by release.sh.

# Public base URL (no trailing /api). Used for dart-define + update-check URL.
API_URL="https://duitkita.ikhsandi.web.id"

# GitHub repo slug (owner/name)
REPO="Ikhsandi-Ramadani/duitkita"

# Target Android ABI for the uploaded APK.
# arm64-v8a = modern 64-bit (recommended). Others: armeabi-v7a, x86_64.
ABI="arm64-v8a"
